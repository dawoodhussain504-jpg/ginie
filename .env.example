# ==========================================
# GINIE — Environment Configuration Template
# ==========================================
# Domain & App Settings
APP_URL=https://ginie.space
PORT=4000
WEB_PORT=3000
NODE_ENV=production

# Supabase Postgres (Pooled connection for running app queries)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Supabase Postgres (Direct connection for Prisma migrations & pg-boss queues)
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase Storage (Server-side private storage access)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# JWT Authentication
JWT_SECRET=change_me_to_a_secure_random_string_min_32_chars
JWT_REFRESH_SECRET=change_me_to_another_secure_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google Cloud Places API (New) - Server-side only
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Outbound Transactional Email (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password
SMTP_FROM="GINIE CRM <no-reply@ginie.space>"

# Meta WhatsApp Cloud API (Phase 2)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# WhatsApp Bridge (Baileys Container)
WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:3001
WHATSAPP_BRIDGE_SECRET=generate_a_random_hmac_secret_for_bridge

# AI Integration (Phase 3)
AI_API_KEY=

# SaaS Billing (Phase 3)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
