generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")

}

// ----------------------------------------------------
// 1. Subscription Plans & Tenants (Companies)
// ----------------------------------------------------
model Plan {
  id           String        @id @default(uuid())
  name         String        @unique // Free, Starter, Pro, Business
  monthlyPrice Decimal       @default(0) @db.Decimal(10, 2)
  limits       Json          @default("{}") // { maxUsers: 5, maxLeads: 1000, monthlyDiscoverySearches: 50, monthlyWhatsAppMessages: 1000 }
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenants       Tenant[]
  subscriptions Subscription[]

  @@map("plans")
}

model Tenant {
  id           String        @id @default(uuid())
  name         String        // Company Name
  slug         String        @unique // company-slug for optional subdomains
  logoUrl      String?
  brandColor   String        @default("#1677ff") // Ant Design primary color
  businessType String?       // shop, school, clinic, factory, services, other
  onboardingCompleted Boolean  @default(false)
  workingHours Json          @default("{\"start\":\"09:00\",\"end\":\"20:00\",\"days\":[1,2,3,4,5,6]}")
  planId       String?
  plan         Plan?         @relation(fields: [planId], references: [id])
  status       String        @default("active") // active, suspended, trial
  settings     Json          @default("{}")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  // Relations
  users                 User[]
  roles                 Role[]
  leadStatuses          LeadStatus[]
  leads                 Lead[]
  contacts              Contact[]
  companies             Company[]
  pipelines             Pipeline[]
  deals                 Deal[]
  tasks                 Task[]
  activities            Activity[]
  discoverySearches     DiscoverySearch[]
  discoveryResults      DiscoveryResult[]
  usageCounters         UsageCounter[]
  whatsAppSessions      WhatsAppSession[]
  whatsAppMessages      WhatsAppMessage[]
  whatsAppRules         WhatsAppAutoReplyRule[]
  whatsAppOptouts       WhatsAppOptOut[]
  messageTemplates      MessageTemplate[]
  products              Product[]
  quotations            Quotation[]
  invoices              Invoice[]
  customFieldDefs       CustomFieldDefinition[]
  webForms              WebForm[]
  workflows             Workflow[]
  workflowRuns          WorkflowRun[]
  auditLogs             AuditLog[]
  subscriptions         Subscription[]
  payments              PaymentRecord[]
  storeOrders           StoreOrder[]
  loyaltyTransactions   LoyaltyTransaction[]
  fieldCheckIns         FieldSalesCheckIn[]
  purchaseOrders        PurchaseOrder[]
  employees             Employee[]
  employeeAttendances   EmployeeAttendance[]
  employeeAdvances      EmployeeAdvance[]
  payrollRecords        PayrollRecord[]
  khataAccounts         KhataAccount[]
  productBatches        ProductBatch[]
  jobCards              JobCard[]
  doctorPrescriptions   DoctorPrescription[]

  @@map("tenants")
}

// ----------------------------------------------------
// 2. Roles, Permissions & Users
// ----------------------------------------------------
model Role {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   // Owner, Manager, Sales Executive, Viewer
  permissions Json     @default("{}")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@unique([tenantId, name])
  @@map("roles")
}

model User {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId           String
  role             Role      @relation(fields: [roleId], references: [id])
  name             String
  email            String
  phone            String?
  passwordHash     String
  status           String    @default("active") // active, invited, suspended
  language         String    @default("en") // en, hi
  lastLoginAt      DateTime?
  twoFactorSecret  String?
  isSuperAdmin     Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  // Relations
  ownedLeads       Lead[]            @relation("LeadOwner")
  ownedDeals       Deal[]            @relation("DealOwner")
  assignedTasks    Task[]            @relation("TaskAssignee")
  activities       Activity[]
  searches         DiscoverySearch[]
  auditLogs        AuditLog[]
  checkIns         FieldSalesCheckIn[]

  @@unique([tenantId, email])
  @@index([tenantId, email])
  @@map("users")
}

// ----------------------------------------------------
// 3. Potential Customers (Leads) & Core CRM
// ----------------------------------------------------
model LeadStatus {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String   // New, Contacted, Qualified, Proposal, Won, Lost
  color      String   @default("#1677ff")
  orderIndex Int      @default(0)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  leads      Lead[]

  @@unique([tenantId, name])
  @@map("lead_statuses")
}

model Lead {
  id                 String      @id @default(uuid())
  tenantId           String
  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String      // Person or primary contact name
  companyName        String?
  phone              String?
  email              String?
  website            String?
  address            String?
  city               String?
  state              String?
  country            String      @default("India")
  pincode            String?
  lat                Float?
  lng                Float?
  googlePlaceId      String?
  source             String      @default("Direct") // Direct, Google Maps, Website Form, Referral, Website Crawl
  statusId           String?
  status             LeadStatus? @relation(fields: [statusId], references: [id])
  ownerId            String?
  owner              User?       @relation("LeadOwner", fields: [ownerId], references: [id])
  score              Int         @default(0)
  aiScoreCategory    String?     // hot, warm, cold
  aiScoreReason      String?     // plain-language explanation of interest score
  aiSummary          String?     // AI key takeaways and notes
  tags               Json        @default("[]")
  customFields       Json        @default("{}")
  createdBy          String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  // Converted relations
  convertedContactId String?
  convertedDealId    String?

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, googlePlaceId])
  @@map("leads")
}

model Company {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  website      String?
  industry     String?
  address      String?
  customFields Json      @default("{}")
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  contacts     Contact[]
  deals        Deal[]

  @@index([tenantId])
  @@map("companies")
}

model Contact {
  id           String            @id @default(uuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId    String?
  company      Company?          @relation(fields: [companyId], references: [id])
  name         String
  phone        String?
  email        String?
  designation  String?
  customFields Json              @default("{}")
  createdBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  deals        Deal[]
  messages     WhatsAppMessage[]
  quotations          Quotation[]
  invoices            Invoice[]
  loyaltyPoints       Int                  @default(0)
  loyaltyTransactions LoyaltyTransaction[]
  khataAccounts       KhataAccount[]

  @@index([tenantId])
  @@map("contacts")
}

// ----------------------------------------------------
// 4. Sales in Progress (Pipelines & Deals)
// ----------------------------------------------------
model Pipeline {
  id        String          @id @default(uuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String          @default("Standard Sales Pipeline")
  isDefault Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  stages    PipelineStage[]
  deals     Deal[]

  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(uuid())
  tenantId    String
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String   // Prospect, Qualified, Proposal Sent, Negotiation, Closed Won, Closed Lost
  probability Int      @default(0) // 0 - 100%
  orderIndex  Int      @default(0)
  color       String   @default("#1677ff")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals       Deal[]

  @@map("pipeline_stages")
}

model Deal {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipelineId    String
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id])
  stageId       String
  stage         PipelineStage @relation(fields: [stageId], references: [id])
  contactId     String?
  contact       Contact?      @relation(fields: [contactId], references: [id])
  companyId     String?
  company       Company?      @relation(fields: [companyId], references: [id])
  ownerId       String?
  owner         User?         @relation("DealOwner", fields: [ownerId], references: [id])
  title         String        // Deal title / subject
  value         Decimal       @default(0) @db.Decimal(12, 2)
  currency      String        @default("INR")
  expectedClose DateTime?
  status        String        @default("open") // open, won, lost
  lostReason    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  quotations    Quotation[]

  @@index([tenantId])
  @@map("deals")
}

// ----------------------------------------------------
// 5. Tasks & Activities
// ----------------------------------------------------
model Task {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueAt       DateTime?
  priority    String    @default("medium") // low, medium, high
  status      String    @default("pending") // pending, completed, cancelled
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  entityType  String?   // lead, contact, deal
  entityId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@map("tasks")
}

model Activity {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  entityType String   // lead, contact, deal
  entityId   String
  type       String   // note, call, email, whatsapp, task, status
  content    String
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("activities")
}

// ----------------------------------------------------
// 6. Google Places Lead Discovery
// ----------------------------------------------------
model DiscoverySearch {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?             @relation(fields: [userId], references: [id])
  country     String            @default("India")
  city        String
  pincode     String?
  category    String            // keyword / place type
  status      String            @default("completed") // pending, running, completed, failed
  resultCount Int               @default(0)
  createdAt   DateTime          @default(now())

  results     DiscoveryResult[]

  @@index([tenantId])
  @@map("discovery_searches")
}

model DiscoveryResult {
  id               String          @id @default(uuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  searchId         String
  search           DiscoverySearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  placeId          String          // Google Places place_id
  name             String
  address          String
  lat              Float?
  lng              Float?
  phone            String?
  website          String?
  email            String?         // Extracted from website crawl
  mapsUrl          String?
  rating           Float?
  userRatingsTotal Int?
  importedLeadId   String?
  createdAt        DateTime        @default(now())

  @@unique([tenantId, searchId, placeId])
  @@index([tenantId, placeId])
  @@map("discovery_results")
}

// ----------------------------------------------------
// 7. WhatsApp Subsystem & Human-like Auto-Reply (Section 5.8.1)
// ----------------------------------------------------
model WhatsAppSession {
  id                   String            @id @default(uuid())
  tenantId             String
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider             String            @default("bridge") // bridge, cloud_api
  phone                String?
  status               String            @default("disconnected") // qr_ready, connected, disconnected, expired
  qrCode               String?
  credentialsEncrypted String?
  warmupStartedAt      DateTime?
  dailyCap             Int               @default(50)
  sentToday            Int               @default(0)
  lastActiveAt         DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  messages             WhatsAppMessage[]

  @@map("whatsapp_sessions")
}

model WhatsAppMessage {
  id           String           @id @default(uuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      WhatsAppSession? @relation(fields: [sessionId], references: [id])
  contactId    String?
  contact      Contact?         @relation(fields: [contactId], references: [id])
  phone        String
  direction    String           // inbound, outbound
  body         String
  media        Json?            // { type: 'image' | 'document', url: string }
  status       String           @default("sent") // scheduled, sending, sent, delivered, read, failed
  scheduledAt  DateTime?
  sentAt       DateTime?
  delayMs      Int?
  typingMs     Int?
  ruleId       String?
  createdAt    DateTime         @default(now())

  @@index([tenantId, phone])
  @@map("whatsapp_messages")
}

model WhatsAppAutoReplyRule {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  triggerType          String   // keyword, first_message, outside_hours, ai
  triggerConfig        Json     @default("{}") // { keywords: ['price', 'quote'], regex: '.*' }
  replyVariants        Json     @default("[]") // ["Hello {name}! Thanks for contacting us.", "Hi {name}, how can we help?"]
  delayMinSeconds      Int      @default(8)
  delayMaxSeconds      Int      @default(45)
  typingCpsMin         Int      @default(4)
  typingCpsMax         Int      @default(7)
  businessHours        Json     @default("{\"enabled\": false, \"start\": \"09:00\", \"end\": \"18:00\"}")
  perContactHourlyCap  Int      @default(5)
  takeoverPauseHours   Int      @default(12)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("whatsapp_auto_reply_rules")
}

model WhatsAppOptOut {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone     String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([tenantId, phone])
  @@map("whatsapp_optouts")
}

// ----------------------------------------------------
// 8. Communication Templates (Email & WhatsApp)
// ----------------------------------------------------
model MessageTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel   String   // whatsapp, email, sms
  name      String
  subject   String?
  body      String
  variables Json     @default("[]")
  status    String   @default("active") // active, draft, archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("message_templates")
}

// ----------------------------------------------------
// 9. Products & Quotations / Invoices (Section 5.9)
// ----------------------------------------------------
model Product {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  price       Decimal  @default(0) @db.Decimal(12, 2)
  taxRate     Decimal  @default(18.0) @db.Decimal(5, 2) // Standard 18% GST default
  unit        String   @default("piece") // piece, month, hour, project
  description        String?
  sku                String?
  category           String?
  imageUrl           String?
  stockInHand        Int      @default(0)
  minStockAlert      Int      @default(5)
  isPublishedToStore Boolean  @default(true)
  isActive           Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batches     ProductBatch[]

  @@map("products")
}

model Quotation {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotationNumber String
  contactId       String?
  contact         Contact?  @relation(fields: [contactId], references: [id])
  dealId          String?
  deal            Deal?     @relation(fields: [dealId], references: [id])
  items           Json      @default("[]") // [{ productId, name, price, quantity, tax, total }]
  subtotal        Decimal   @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal   @default(0) @db.Decimal(12, 2)
  total           Decimal   @default(0) @db.Decimal(12, 2)
  currency        String    @default("INR")
  status          String    @default("draft") // draft, sent, accepted, rejected, converted
  validUntil      DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invoices        Invoice[]

  @@map("quotations")
}

model Invoice {
  id            String     @id @default(uuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceNumber String
  quotationId   String?
  quotation     Quotation? @relation(fields: [quotationId], references: [id])
  contactId     String?
  contact       Contact?   @relation(fields: [contactId], references: [id])
  items         Json       @default("[]")
  subtotal      Decimal    @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal    @default(0) @db.Decimal(12, 2)
  total         Decimal    @default(0) @db.Decimal(12, 2)
  currency      String     @default("INR")
  status        String     @default("unpaid") // unpaid, partial, paid, cancelled
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("invoices")
}

// ----------------------------------------------------
// 10. Extra Details (Custom Fields) & Web Forms
// ----------------------------------------------------
model CustomFieldDefinition {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String   // lead, contact, company, deal
  key        String   // field identifier
  label      String   // display label
  fieldType  String   // text, number, date, dropdown, boolean
  options    Json     @default("[]") // for dropdown
  isRequired Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, entityType, key])
  @@map("custom_field_definitions")
}

model WebForm {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fields      Json     @default("[]") // [{ name: 'name', label: 'Your Name', required: true }]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("web_forms")
}

// ----------------------------------------------------
// 11. Usage Counters & Metering
// ----------------------------------------------------
model UsageCounter {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metric      String   // discovery_searches, whatsapp_messages, users
  counter     Int      @default(0)
  periodStart DateTime @default(now())
  periodEnd   DateTime

  @@unique([tenantId, metric, periodStart])
  @@map("usage_counters")
}

// ----------------------------------------------------
// 12. Workflow Automations ("Auto Actions")
// ----------------------------------------------------
model Workflow {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  triggerEvent String        // customer.created, deal.stage_changed, task.overdue, form.submitted
  conditions   Json          @default("[]") // [{ field, operator, value }]
  actions      Json          @default("[]") // [{ type: 'send_whatsapp'|'create_task'|'assign_owner'|'webhook', ... }]
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  runs         WorkflowRun[]

  @@map("workflows")
}

model WorkflowRun {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  entityId    String?
  status      String    @default("success") // success, failed, running
  result      Json      @default("{}")
  executedAt  DateTime  @default(now())

  @@map("workflow_runs")
}

// ----------------------------------------------------
// 13. Audit Logs (Activity History)
// ----------------------------------------------------
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // create, update, delete, login, export
  entity     String   // lead, deal, quotation, invoice, settings, user
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@map("audit_logs")
}

// ----------------------------------------------------
// 14. Subscriptions & Payments
// ----------------------------------------------------
model Subscription {
  id                     String    @id @default(uuid())
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan      @relation(fields: [planId], references: [id])
  provider               String    @default("razorpay") // razorpay, stripe, manual
  providerSubscriptionId String?
  status                 String    @default("active") // active, past_due, cancelled, trialing
  currentPeriodStart     DateTime  @default(now())
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@map("subscriptions")
}

model PaymentRecord {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider          String   // razorpay, stripe
  providerPaymentId String?
  amount            Decimal  @db.Decimal(10, 2)
  currency          String   @default("INR")
  status            String   @default("succeeded") // succeeded, pending, failed
  metadata          Json?
  createdAt         DateTime @default(now())

  @@map("payment_records")
}

// ----------------------------------------------------
// 15. Digital Storefront, ERP & Field Operations
// ----------------------------------------------------
model StoreOrder {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerName    String
  customerPhone   String
  customerAddress String?
  items           Json     @default("[]")
  subtotal        Decimal  @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal  @default(0) @db.Decimal(12, 2)
  total           Decimal  @default(0) @db.Decimal(12, 2)
  status          String   @default("pending") // pending, confirmed, delivered, cancelled
  paymentMethod   String   @default("cod") // cod, upi
  paymentStatus   String   @default("unpaid") // unpaid, paid
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@map("store_orders")
}

model LoyaltyTransaction {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  points      Int      // positive for earned, negative for redeemed
  reason      String   // purchase, redemption, bonus, adjustment
  invoiceId   String?
  createdAt   DateTime @default(now())

  @@index([tenantId, contactId])
  @@map("loyalty_transactions")
}

model FieldSalesCheckIn {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName  String
  clientPhone String?
  lat         Float
  lng         Float
  address     String?
  battery     Int?     // battery percentage
  notes       String?
  photoUrl    String?
  createdAt   DateTime @default(now())

  @@index([tenantId, userId])
  @@map("field_sales_check_ins")
}

model PurchaseOrder {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  poNumber    String
  vendorName  String
  vendorPhone String?
  vendorEmail String?
  items       Json      @default("[]")
  subtotal    Decimal   @default(0) @db.Decimal(12, 2)
  taxTotal    Decimal   @default(0) @db.Decimal(12, 2)
  total       Decimal   @default(0) @db.Decimal(12, 2)
  status      String    @default("draft") // draft, ordered, received, cancelled
  notes       String?
  receivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@map("purchase_orders")
}

// ----------------------------------------------------
// 22. HR, Staff & Payroll Management (कर्मचारी व वेतन)
// ----------------------------------------------------
model Employee {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  email         String?
  role          String    // e.g. "Head Chef", "Billing Counter", "Master Mechanic", "Sales Executive", "Helper"
  department    String?   // "Kitchen", "Workshop", "Floor", "Accounts", etc.
  salaryType    String    @default("monthly") // monthly, daily, commission, hourly
  baseSalary    Decimal   @default(0) @db.Decimal(12, 2)
  commissionPct Decimal   @default(0) @db.Decimal(5, 2)
  upiId         String?   // For 1-click UPI payouts
  bankAccount   String?
  bankIfsc      String?
  status        String    @default("active") // active, inactive, on_leave
  joinedDate    DateTime  @default(now())
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  attendances   EmployeeAttendance[]
  advances      EmployeeAdvance[]
  payrollRecords PayrollRecord[]

  @@index([tenantId])
  @@map("employees")
}

model EmployeeAttendance {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime  @db.Date
  status        String    @default("present") // present, absent, half_day, paid_leave
  overtimeHours Float     @default(0)
  checkInTime   String?
  checkOutTime  String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, employeeId, date])
  @@index([tenantId, date])
  @@map("employee_attendances")
}

model EmployeeAdvance {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount           Decimal   @db.Decimal(12, 2)
  date             DateTime  @default(now())
  reason           String?
  isSettled        Boolean   @default(false)
  settledPayrollId String?
  createdAt        DateTime  @default(now())

  @@index([tenantId, employeeId])
  @@map("employee_advances")
}

model PayrollRecord {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month            Int       // 1-12
  year             Int       // e.g. 2026
  totalDays        Int       @default(30)
  presentDays      Float     @default(0)
  halfDays         Float     @default(0)
  absentDays       Float     @default(0)
  overtimeHours    Float     @default(0)
  basePay          Decimal   @default(0) @db.Decimal(12, 2)
  overtimePay      Decimal   @default(0) @db.Decimal(12, 2)
  commissionPay    Decimal   @default(0) @db.Decimal(12, 2)
  advancesDeducted Decimal   @default(0) @db.Decimal(12, 2)
  netPayable       Decimal   @default(0) @db.Decimal(12, 2)
  status           String    @default("pending") // pending, paid, partially_paid
  paymentMethod    String?   // cash, upi, bank
  paymentRef       String?
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, employeeId, month, year])
  @@index([tenantId, month, year])
  @@map("payroll_records")
}

// ----------------------------------------------------
// 23. Digital Udhari Khata & Party Ledger (खाता बही)
// ----------------------------------------------------
model KhataAccount {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partyType      String       @default("customer") // "customer" or "supplier"
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  partyName      String
  partyPhone     String
  currentBalance Decimal      @default(0) @db.Decimal(12, 2) // positive = they owe us (उधार), negative = advance
  creditLimit    Decimal      @default(50000) @db.Decimal(12, 2)
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  entries        KhataEntry[]

  @@index([tenantId, partyPhone])
  @@map("khata_accounts")
}

model KhataEntry {
  id                 String       @id @default(uuid())
  tenantId           String
  accountId          String
  account            KhataAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type               String       // "debit" (उधार दिया / Gave) or "credit" (जमा लिया / Received)
  amount             Decimal      @db.Decimal(12, 2)
  balanceAfter       Decimal      @db.Decimal(12, 2)
  date               DateTime     @default(now())
  invoiceId          String?
  paymentMethod      String?      // "cash", "upi", "bank"
  description        String?
  billAttachmentUrl  String?
  createdAt          DateTime     @default(now())

  @@index([tenantId, accountId])
  @@map("khata_entries")
}

// ----------------------------------------------------
// 24. Batch No & Expiry Tracking (दवा व फूड एक्सपायरी)
// ----------------------------------------------------
model ProductBatch {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber    String
  mfgDate        DateTime?
  expDate        DateTime
  quantity       Int       @default(0)
  purchasePrice  Decimal?  @db.Decimal(12, 2)
  mrp            Decimal?  @db.Decimal(12, 2)
  sellingPrice   Decimal?  @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())

  @@index([tenantId, productId])
  @@map("product_batches")
}

// ----------------------------------------------------
// 25. Trade Superpowers: Automobile Job Card (जॉब कार्ड)
// ----------------------------------------------------
model JobCard {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobNumber          String
  customerName       String
  customerPhone      String
  vehicleNumber      String
  vehicleModel       String
  kmReading          Int?
  fuelLevel          String?
  complaints         Json      @default("[]")
  estimatedCost      Decimal   @default(0) @db.Decimal(12, 2)
  assignedTechnician String?
  status             String    @default("pending") // pending, in_progress, ready, delivered
  deliveredAt        DateTime?
  invoiceId          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId, vehicleNumber])
  @@map("job_cards")
}

// ----------------------------------------------------
// 26. Trade Superpowers: Doctor Digital Prescription (Rx)
// ----------------------------------------------------
model DoctorPrescription {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rxNumber           String
  patientName        String
  patientPhone       String
  patientAge         Int?
  patientGender      String?
  symptoms           String?
  diagnosis          String?
  medicines          Json      @default("[]")
  testsAdvised       String?
  nextVisitDate      DateTime?
  consultationFee    Decimal   @default(0) @db.Decimal(12, 2)
  createdAt          DateTime  @default(now())

  @@index([tenantId, rxNumber])
  @@map("doctor_prescriptions")
}
