generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------
// 1. Subscription Plans & Tenants (Companies)
// ----------------------------------------------------
model Plan {
  id           String        @id @default(uuid())
  name         String        @unique // Free, Starter, Pro, Business
  monthlyPrice Decimal       @default(0) @db.Decimal(10, 2)
  limits       Json          @default("{}") // { maxUsers: 5, maxLeads: 1000, monthlyDiscoverySearches: 50 }
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenants      Tenant[]

  @@map("plans")
}

model Tenant {
  id           String        @id @default(uuid())
  name         String        // Company Name
  slug         String        @unique // company-slug for optional subdomains
  logoUrl      String?
  brandColor   String        @default("#1677ff") // Ant Design primary color
  planId       String?
  plan         Plan?         @relation(fields: [planId], references: [id])
  status       String        @default("active") // active, suspended, trial
  settings     Json          @default("{}")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  // Relations
  users             User[]
  roles             Role[]
  leadStatuses      LeadStatus[]
  leads             Lead[]
  contacts          Contact[]
  companies         Company[]
  pipelines         Pipeline[]
  deals             Deal[]
  tasks             Task[]
  activities        Activity[]
  discoverySearches DiscoverySearch[]
  discoveryResults  DiscoveryResult[]
  usageCounters     UsageCounter[]

  @@map("tenants")
}

// ----------------------------------------------------
// 2. Roles, Permissions & Users
// ----------------------------------------------------
model Role {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   // Owner, Manager, Sales Executive, Viewer
  permissions Json     @default("{}")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@unique([tenantId, name])
  @@map("roles")
}

model User {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId           String
  role             Role      @relation(fields: [roleId], references: [id])
  name             String
  email            String
  phone            String?
  passwordHash     String
  status           String    @default("active") // active, invited, suspended
  language         String    @default("en") // en, hi
  lastLoginAt      DateTime?
  twoFactorSecret  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  // Relations
  ownedLeads       Lead[]            @relation("LeadOwner")
  ownedDeals       Deal[]            @relation("DealOwner")
  assignedTasks    Task[]            @relation("TaskAssignee")
  activities       Activity[]
  searches         DiscoverySearch[]

  @@unique([tenantId, email])
  @@index([tenantId, email])
  @@map("users")
}

// ----------------------------------------------------
// 3. Potential Customers (Leads) & Core CRM
// ----------------------------------------------------
model LeadStatus {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String   // New, Contacted, Qualified, Proposal, Won, Lost
  color      String   @default("#1677ff")
  orderIndex Int      @default(0)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  leads      Lead[]

  @@unique([tenantId, name])
  @@map("lead_statuses")
}

model Lead {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String      // Person or primary contact name
  companyName   String?
  phone         String?
  email         String?
  website       String?
  address       String?
  city          String?
  state         String?
  country       String      @default("India")
  pincode       String?
  lat           Float?
  lng           Float?
  googlePlaceId String?
  source        String      @default("Direct") // Direct, Google Maps, Website Form, Referral
  statusId      String?
  status        LeadStatus? @relation(fields: [statusId], references: [id])
  ownerId       String?
  owner         User?       @relation("LeadOwner", fields: [ownerId], references: [id])
  score         Int         @default(0)
  tags          Json        @default("[]")
  customFields  Json        @default("{}")
  createdBy     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  // Converted relations
  convertedContactId String?
  convertedDealId    String?

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, googlePlaceId])
  @@map("leads")
}

model Company {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  website      String?
  industry     String?
  address      String?
  customFields Json      @default("{}")
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  contacts     Contact[]
  deals        Deal[]

  @@index([tenantId])
  @@map("companies")
}

model Contact {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])
  name         String
  phone        String?
  email        String?
  designation  String?
  customFields Json      @default("{}")
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  deals        Deal[]

  @@index([tenantId])
  @@map("contacts")
}

// ----------------------------------------------------
// 4. Sales in Progress (Pipelines & Deals)
// ----------------------------------------------------
model Pipeline {
  id        String          @id @default(uuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String          @default("Standard Sales Pipeline")
  isDefault Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  stages    PipelineStage[]
  deals     Deal[]

  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(uuid())
  tenantId    String
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String   // Prospect, Qualified, Proposal Sent, Negotiation, Closed Won, Closed Lost
  probability Int      @default(0) // 0 - 100%
  orderIndex  Int      @default(0)
  color       String   @default("#1677ff")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals       Deal[]

  @@map("pipeline_stages")
}

model Deal {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipelineId    String
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id])
  stageId       String
  stage         PipelineStage @relation(fields: [stageId], references: [id])
  contactId     String?
  contact       Contact?      @relation(fields: [contactId], references: [id])
  companyId     String?
  company       Company?      @relation(fields: [companyId], references: [id])
  ownerId       String?
  owner         User?         @relation("DealOwner", fields: [ownerId], references: [id])
  title         String        // Deal title / subject
  value         Decimal       @default(0) @db.Decimal(12, 2)
  currency      String        @default("INR")
  expectedClose DateTime?
  status        String        @default("open") // open, won, lost
  lostReason    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@index([tenantId])
  @@map("deals")
}

// ----------------------------------------------------
// 5. Tasks & Activities
// ----------------------------------------------------
model Task {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueAt       DateTime?
  priority    String    @default("medium") // low, medium, high
  status      String    @default("pending") // pending, completed, cancelled
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  entityType  String?   // lead, contact, deal
  entityId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@map("tasks")
}

model Activity {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  entityType String   // lead, contact, deal
  entityId   String
  type       String   // note, call, email, whatsapp, task, status
  content    String
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("activities")
}

// ----------------------------------------------------
// 6. Google Places Lead Discovery
// ----------------------------------------------------
model DiscoverySearch {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?             @relation(fields: [userId], references: [id])
  country     String            @default("India")
  city        String
  pincode     String?
  category    String            // keyword / place type
  status      String            @default("completed") // pending, running, completed, failed
  resultCount Int               @default(0)
  createdAt   DateTime          @default(now())

  results     DiscoveryResult[]

  @@index([tenantId])
  @@map("discovery_searches")
}

model DiscoveryResult {
  id               String          @id @default(uuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  searchId         String
  search           DiscoverySearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  placeId          String          // Google Places place_id
  name             String
  address          String
  lat              Float?
  lng              Float?
  phone            String?
  website          String?
  email            String?         // Extracted from website crawl
  mapsUrl          String?
  rating           Float?
  userRatingsTotal Int?
  importedLeadId   String?
  createdAt        DateTime        @default(now())

  @@unique([tenantId, searchId, placeId])
  @@index([tenantId, placeId])
  @@map("discovery_results")
}

// ----------------------------------------------------
// 7. Usage Counters & Metering
// ----------------------------------------------------
model UsageCounter {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metric      String   // discovery_searches, whatsapp_messages, users
  counter     Int      @default(0)
  periodStart DateTime @default(now())
  periodEnd   DateTime

  @@unique([tenantId, metric, periodStart])
  @@map("usage_counters")
}
